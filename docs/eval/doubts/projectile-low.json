     "target": "g",
     "effect": "grow"
    },
    {
     "do": "highlight",
     "target": "g",
     "state": "active",
     "hold": true
    }
   ],
   "pace": "normal"
  },
  {
   "title": "Vertical speed over time",
   "narration": "The vertical speed starts at 5.66 m/s and decreases linearly until it reaches zero at the apex.",
