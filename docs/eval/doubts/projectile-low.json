    {
     "do": "create",
     "target": "ball",
     "effect": "pop"
    },
    {
     "do": "create",
     "target": "v0",
     "effect": "grow"
    },
    {
     "do": "create",
     "target": [
      "vx",
      "vy"
     ],
     "effect": "grow"
    }
   ],
   "pace": "normal"
  },
  {
   "title": "Gravity bends the path",
