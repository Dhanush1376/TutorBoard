      "v0",
      "vx",
      "vy"
     ],
     "effect": "fade"
    },
    {
     "do": "create",
     "target": "traj",
     "effect": "draw"
    },
    {
     "with": "previous",
     "do": "trace",
     "target": "ball",
     "along": "traj",
     "duration": "long"
    }
   ],
   "pace": "normal"
  },
  {
   "title": "Show gravity",
