    {
     "do": "create",
     "target": "vy2",
     "effect": "draw"
    },
    {
     "do": "highlight",
     "target": "vy2",
     "state": "comparing",
     "hold": true
    }
   ],
   "pace": "normal"
  },
  {
   "title": "Resulting trajectory",
   "narration": "With horizontal speed unchanged and vertical speed decreasing, the combined motion traces a curved parabola instead of a straight line.",
