   {
    "key": "stackqueue",
    "vo": "Explore algorithms.",
    "title": "Stack vs Queue",
    "question": "What is the difference between a stack and a queue?",
    "kind": "ALGORITHM SESSION",
    "guide": "ALGORITHM GUIDE",
    "steps": [
     "Push onto the stack",
     "Enqueue at the rear",
     "Pop from the top (LIFO)",
     "Dequeue from the front (FIFO)"
    ],
    "explain": [
     "A stack only ever touches its top: each push lands on the last one.",
     "A queue adds at the rear and serves from the front, like a line at a counter.",
     "pop() removes the most recent push — Last In, First Out.",
     "dequeue() serves the oldest item first — First In, First Out."
    ],
    "start": 15,
    "end": 120
   },
   {
    "key": "geometry",
    "vo": "Build geometry.",
    "title": "Triangle Angle Sum",
    "question": "Why do the angles of a triangle add up to 180°?",
    "kind": "CONCEPT SESSION",
    "guide": "CONCEPT GUIDE",
    "steps": [
     "Construct triangle ABC",
     "Mark the three angles",
     "Draw a parallel through C",
     "They form a straight line"
    ],
    "explain": [
     "Start with any triangle ABC.",
     "Call its angles α, β and γ.",
     "Draw the line through C parallel to AB. Alternate angles copy α and β up to C.",
     "α, γ and β now sit side by side on a straight line — so they add to 180°."
    ],
    "start": 120,
    "end": 225
   },
   {
    "key": "physics",
    "vo": "Understand physics.",
    "title": "Projectile Motion at 45°",
    "question": "How does a ball kicked at 45° actually travel?",
    "kind": "CONCEPT SESSION",
    "guide": "CONCEPT GUIDE",
    "steps": [
     "Split the launch velocity",
     "Gravity bends the path",
     "Maximum height",
     "Landing and range"
    ],
    "explain": [
     "At 45° the launch speed splits into equal horizontal and vertical parts.",
     "Horizontal speed stays constant; gravity pulls the vertical speed down 9.8 m/s every second.",
     "At the top the vertical speed is zero — only vₓ remains.",
     "The path is a parabola; 45° gives the longest range on flat ground."
    ],
    "start": 225,
    "end": 330
   },
   {
    "key": "chem",
    "vo": "Visualize chemistry.",
    "title": "Why Water Is Bent",
    "question": "Why is a water molecule bent instead of straight?",
    "kind": "CONCEPT SESSION",
    "guide": "CONCEPT GUIDE",
    "steps": [
     "Oxygen bonds two hydrogens",
     "Two lone pairs push back",
     "The 104.5° bond angle"
    ],
    "explain": [
     "Oxygen shares one electron pair with each hydrogen.",
     "Oxygen also keeps two lone pairs. They repel the bonding pairs more strongly.",
     "The bonds are squeezed from 109.5° to 104.5° — so water is bent, and polar."
    ],
    "start": 330,
    "end": 435
