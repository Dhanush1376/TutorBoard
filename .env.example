# TutorBoard Environment Variables Example

# --- Server Configuration ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# --- Database & Cache ---
# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/tutorboard
# Redis Connection String (Optional, recommended for rate-limiting and caching)
REDIS_URL=redis://localhost:6379

# --- Security & Auth ---
# JWT Secret for session tokens
JWT_SECRET=your_jwt_secret_here
# 32-character hex key for AES-256 encryption of user API keys
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# --- AI Providers ---
# All AI providers (including Gemini, Claude, GPT-4) route through OpenRouter.
# OPENROUTER_API_KEY is the only key required for all AI functionality.
# To use models directly (without OpenRouter), add provider-specific keys below:
# GOOGLE_API_KEY=your_google_ai_studio_key   # For direct Gemini access
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx
GOOGLE_API_KEY=xxxxxxxxxxxx

# --- Social Login (Optional) ---
# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx

# --- Social Login (Optional) ---
# GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
