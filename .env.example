# ==========================================
# TutorBoard Environment Variables Reference
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# [Required] The port the Node.js server will run on
PORT=5000

# [Required] Environment mode (development, production, or test)
NODE_ENV=development

# [Required] The URL of the React frontend, used for CORS and auth redirects
FRONTEND_URL=http://localhost:5173

# [Optional] A comma-separated list of allowed origins for CORS (Socket.IO & HTTP)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ------------------------------------------
# Database & Cache
# ------------------------------------------
# [Required] MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/tutorboard

# [Required for Research Mode] Brave Search API Key
# Get one at: https://api.search.brave.com/app/dashboard
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here


# ------------------------------------------
# Security & Auth
# ------------------------------------------
# [Required] Secret used to sign JWT access tokens
JWT_SECRET=your_super_secret_jwt_key_here

# [Required] Secret used to sign JWT refresh tokens (MUST be different from JWT_SECRET)
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_here

# [Optional] JWT Expiry Time (default: 7d)
JWT_EXPIRES_IN=7d

# [Required] 64-character hex key for AES-256 encryption. Used to securely encrypt API keys stored in the database.
# !!! IMPORTANT !!!: CHANGE THIS BEFORE DEPLOYING. ALL API KEYS ENCRYPTED WITH THE DEFAULT KEY WILL BE COMPROMISED.
# Generate a secure key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ------------------------------------------
# AI Providers
# ------------------------------------------
# [Required] OpenRouter is the primary AI orchestration platform for the 6-agent pipeline.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# [Optional] Fallback direct Anthropic key if skipping OpenRouter for the Claude agents
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# [Optional] Fallback direct Google key for Gemini access
GOOGLE_API_KEY=xxxxxxxxxxxx

# ------------------------------------------
# Social Login (Optional)
# ------------------------------------------
# [Optional] Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx

# [Optional] GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx

# ------------------------------------------
# Sentry Error Tracking (Optional but Recommended for Production)
# ------------------------------------------
# [Optional] Sentry DSN for the Node.js Backend
SENTRY_DSN=your_backend_sentry_dsn

# [Optional] Sentry DSN for the React/Vite Frontend
VITE_SENTRY_DSN=your_frontend_sentry_dsn

# ------------------------------------------
# Email (SMTP) — verification codes, password reset codes, security notices
# ------------------------------------------
# Any SMTP provider works. Brevo: Settings → SMTP & API → SMTP tab.
#   SMTP_HOST=smtp-relay.brevo.com, SMTP_PORT=587,
#   SMTP_USER = the "Login" shown there (e.g. 8a1b2c001@smtp-brevo.com),
#   SMTP_PASS = an SMTP key you generate there (not your Brevo account password).
SMTP_HOST=smtp-relay.brevo.com
# 587 = STARTTLS (recommended), 465 = implicit TLS
SMTP_PORT=587
# [Optional] Force TLS mode; defaults to true only for port 465
SMTP_SECURE=
SMTP_USER=your_smtp_login
SMTP_PASS=your_smtp_key
# Sender shown to users. Must be a sender/domain your provider has verified
# (Brevo: Senders, Domains & Dedicated IPs → Senders).
MAIL_FROM=TutorBoard <no-reply@yourdomain.com>

# ------------------------------------------
# S3 File Storage (Required for Production/Render)
# ------------------------------------------
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=us-east-1
S3_BUCKET=your_bucket_name

# ------------------------------------------
# Code Execution (Judge0)
# ------------------------------------------
# [Optional] Judge0 API Key (RapidAPI or Self-hosted Auth Token)
# REQUIRED FOR PRODUCTION. Code execution will be disabled without a valid key in production.
JUDGE0_API_KEY=your_judge0_api_key
# [Optional] Judge0 Host (default: ce.judge0.com)
# For RapidAPI use: judge0-ce.p.rapidapi.com
# For self-hosted use your instance URL (e.g. judge0.example.com)
JUDGE0_HOST=ce.judge0.com

# ------------------------------------------
# Identity, sessions & admin (placeholders only — never commit real values)
# ------------------------------------------
# [Required in production] Public URL of this API. OAuth callbacks default to
# $BACKEND_URL/api/auth/{google,github}/callback — register exactly these URLs in
# the Google Cloud console (Authorized redirect URIs) and the GitHub OAuth app
# (Authorization callback URL).
BACKEND_URL=https://api.example.com
# [Optional] Override the callback URLs if the API sits behind a different public path
GOOGLE_CALLBACK_URL=
GITHUB_CALLBACK_URL=
# ALLOWED_ORIGINS (above) is now read by the API: comma-separated extra origins; FRONTEND_URL is always allowed.
# [Optional] How often each instance re-reads admin platform settings and AI providers (ms, default 15000)
PLATFORM_CONFIG_REFRESH_MS=15000
# [Development only] Write outgoing email to this file instead of sending it
# (used when SMTP is not configured; ignored in production)
MAIL_DEV_OUTBOX=
# [Development only] Allow admin AI providers on http:// / private addresses (e.g. a local Ollama). Ignored in production.
ALLOW_PRIVATE_AI_ENDPOINTS=false
# Super-admins, comma-separated. An account becomes super-admin only once it exists
# with this email VERIFIED (so nobody can claim it by registering the address first).
# Super-admins approve or decline admin access requests and can revoke admins in
# the admin portal (/admin → Admin access). They can't be added or removed from the website.
SUPERADMIN_EMAILS=owner@example.com
# Break-glass from a shell (admin/user only): node server/scripts/grant-admin.mjs you@example.com admin
