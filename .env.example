# ==========================================
# TutorBoard Environment Variables Reference
# ==========================================

# ------------------------------------------
# Server Configuration
# ------------------------------------------
# [Required] The port the Node.js server will run on
PORT=5000

# [Required] Environment mode (development, production, or test)
NODE_ENV=development

# [Required] The URL of the React frontend, used for CORS and auth redirects
FRONTEND_URL=http://localhost:5173

# [Optional] A comma-separated list of allowed origins for CORS (Socket.IO & HTTP)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# ------------------------------------------
# Database & Cache
# ------------------------------------------
# [Required] MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/tutorboard

# [Required for Research Mode] Brave Search API Key
# Get one at: https://api.search.brave.com/app/dashboard
BRAVE_SEARCH_API_KEY=your_brave_search_api_key_here


# ------------------------------------------
# Security & Auth
# ------------------------------------------
# [Required] Secret used to sign JWT access tokens
JWT_SECRET=your_super_secret_jwt_key_here

# [Optional] JWT Expiry Time (default: 7d)
JWT_EXPIRES_IN=7d

# [Required] 64-character hex key for AES-256 encryption. Used to securely encrypt API keys stored in the database.
# !!! IMPORTANT !!!: CHANGE THIS BEFORE DEPLOYING. ALL API KEYS ENCRYPTED WITH THE DEFAULT KEY WILL BE COMPROMISED.
# Generate a secure key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=your_64_char_hex_key_here

# ------------------------------------------
# AI Providers
# ------------------------------------------
# [Required] OpenRouter is the primary AI orchestration platform for the 6-agent pipeline.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxx

# [Optional] Fallback direct Anthropic key if skipping OpenRouter for the Claude agents
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx

# [Optional] Fallback direct Google key for Gemini access
GOOGLE_API_KEY=xxxxxxxxxxxx

# ------------------------------------------
# Social Login (Optional)
# ------------------------------------------
# [Optional] Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx

# [Optional] GitHub OAuth 2.0 Credentials
GITHUB_CLIENT_ID=xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx

# ------------------------------------------
# Sentry Error Tracking (Optional but Recommended for Production)
# ------------------------------------------
# [Optional] Sentry DSN for the Node.js Backend
SENTRY_DSN=your_backend_sentry_dsn

# [Optional] Sentry DSN for the React/Vite Frontend
VITE_SENTRY_DSN=your_frontend_sentry_dsn

# ------------------------------------------
# Notifications (Email via Resend)
# ------------------------------------------
# [Optional] Resend API Key for transactional emails
RESEND_API_KEY=re_xxxxxxxxxxxx
# [Optional] Verified sender email
MAIL_FROM=TutorBoard <onboarding@resend.dev>

# ------------------------------------------
# S3 File Storage (Required for Production/Render)
# ------------------------------------------
S3_ACCESS_KEY_ID=your_access_key_id
S3_SECRET_ACCESS_KEY=your_secret_access_key
S3_REGION=us-east-1
S3_BUCKET=your_bucket_name

# ------------------------------------------
# Code Execution (Judge0)
# ------------------------------------------
# [Optional] Judge0 API Key (RapidAPI or Self-hosted Auth Token)
# REQUIRED FOR PRODUCTION. Code execution will be disabled without a valid key in production.
JUDGE0_API_KEY=your_judge0_api_key
# [Optional] Judge0 Host (default: ce.judge0.com)
# For RapidAPI use: judge0-ce.p.rapidapi.com
# For self-hosted use your instance URL (e.g. judge0.example.com)
JUDGE0_HOST=ce.judge0.com
