{
  "//": "Typecheck for Engine v2 (src/scene) and its Scene Lab. Run: npx tsc -p tsconfig.scene.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "types": ["vite/client"]
  },
  "include": ["src/scene/**/*.ts", "src/dev/sceneLab.ts"]
}
