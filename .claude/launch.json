{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "client",
        "--",
        "--port",
        "5199",
        "--strictPort"
      ],
      "port": 5199,
      "autoPort": false
    },
    {
      "name": "promo-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "promo-video/capture/start-backend.mjs"
      ],
      "port": 5055,
      "autoPort": false
    },
    {
      "name": "promo-client",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "client/node_modules/vite/bin/vite.js",
        "--configLoader",
        "native",
        "--config",
        "promo-video/capture/vite.capture.config.mjs"
      ],
      "port": 5174,
      "autoPort": false
    },
    {
      "name": "scene-lab-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/scripts/scene-lab-backend.mjs"
      ],
      "port": 5055,
      "autoPort": false
    },
    {
      "name": "app-v2",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "client/scripts/dev-v2.mjs"
      ],
      "port": 5199,
      "autoPort": false
    },
    {
      "name": "app-v2-alt",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "client/scripts/dev-v2.mjs",
        "5198"
      ],
      "port": 5198,
      "autoPort": false
    },
    {
      "name": "chat-e2e-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "e2e/support/isolated-backend.mjs"
      ],
      "port": 5066,
      "autoPort": false
    },
    {
      "name": "chat-e2e-app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "e2e/support/isolated-app.mjs"
      ],
      "port": 5197,
      "autoPort": false
    },
    {
      "name": "viz-e2e-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "e2e/support/viz-backend.mjs"
      ],
      "port": 5067,
      "autoPort": false
    },
    {
      "name": "viz-e2e-app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "e2e/support/viz-app.mjs"
      ],
      "port": 5196,
      "autoPort": false
    }
  ]
}
